# WalletConnect — get a free project ID at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Monad testnet RPC
NEXT_PUBLIC_MONAD_RPC=https://testnet-rpc.monad.xyz

# Set this after deploying MarketFactory
NEXT_PUBLIC_FACTORY_ADDRESS=

# Pyth Hermes endpoints
NEXT_PUBLIC_PYTH_HERMES=https://hermes.pyth.network
NEXT_PUBLIC_PYTH_HERMES_BETA=https://hermes-beta.pyth.network

# (optional) Admin / deployer address — shown in UI or used for access checks
NEXT_PUBLIC_ADMIN_ADDRESS=
